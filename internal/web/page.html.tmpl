<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>
  :root {
    --fg: #1a1a1a; --bg: #fafafa; --muted: #6a6a6a;
    --accent: #4338ca; --code-bg: #f0f0f0; --border: #e5e5e5;
  }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #e8e8e8; --bg: #14171a; --muted: #9aa0a6;
            --accent: #a5b4fc; --code-bg: #1f242a; --border: #2a3038; }
  }
  html, body { background: var(--bg); color: var(--fg); }
  body { max-width: 48rem; margin: 2rem auto; padding: 0 1.25rem;
         font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI",
              "Helvetica Neue", Arial, sans-serif; }
  h1, h2, h3 { line-height: 1.25; margin-top: 1.6em; }
  h1 { border-bottom: 1px solid var(--border); padding-bottom: .3em; }
  a { color: var(--accent); }
  code { background: var(--code-bg); padding: .15em .35em; border-radius: 3px;
         font-size: .92em; }
  pre { background: var(--code-bg); padding: 1rem; overflow-x: auto;
        border-radius: 4px; }
  pre code { padding: 0; background: transparent; font-size: .9em; }
  blockquote { border-left: 3px solid var(--border); padding-left: 1rem;
               color: var(--muted); margin-left: 0; }
  table { border-collapse: collapse; }
  td, th { border: 1px solid var(--border); padding: .35em .7em; }
  hr { border: none; border-top: 1px solid var(--border); margin: 2em 0; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border);
           color: var(--muted); font-size: .85em; }
</style>
</head>
<body>
<main>
{{.Body}}
</main>
<footer>glow-web · {{.Title}}</footer>
</body>
</html>
