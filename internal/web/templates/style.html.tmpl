{{define "style"}}
<style>
/* Theme variables. The early-head theme-init script resolves the user's
   choice (auto / light / dark) into a concrete data-theme="light|dark"
   attribute on <html> before paint, so we don't need a @media query
   here. The fallback for no-JS environments is light. */
:root, :root[data-theme="light"] {
  --fg: #1a1a1a; --bg: #fafafa; --muted: #6a6a6a;
  --accent: #4338ca; --code-bg: #f0f0f0; --border: #e5e5e5;
  --bar-bg: #ffffff;
}
:root[data-theme="dark"] {
  --fg: #e8e8e8; --bg: #14171a; --muted: #9aa0a6;
  --accent: #a5b4fc; --code-bg: #1f242a; --border: #2a3038;
  --bar-bg: #1a1f25;
}
* { box-sizing: border-box; }
html, body { margin: 0; background: var(--bg); color: var(--fg); }
body {
  font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI",
        "Helvetica Neue", Arial, sans-serif;
  min-height: 100vh; display: flex; flex-direction: column;
}
.bar {
  background: var(--bar-bg); border-bottom: 1px solid var(--border);
  padding: .55rem 1rem; display: flex; align-items: center;
  gap: 1rem; flex-wrap: wrap;
}
.bar-path {
  color: var(--muted); font-size: .85em;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.crumbs {
  display: flex; align-items: baseline; gap: .35em;
  flex: 1; min-width: 0; flex-wrap: wrap;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: .95rem;
}
.crumb { color: var(--accent); text-decoration: none; font-weight: 500; }
.crumb:hover { text-decoration: underline; }
.crumb-current { color: var(--fg); font-weight: 600; }
.crumb-sep { color: var(--muted); }
.parent-hint {
  color: var(--muted); font-size: .75rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  opacity: .7; margin-bottom: .05em;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.theme-toggle {
  min-width: 2.2em; padding: .25rem .4rem; text-align: center;
  border: 1px solid var(--border); border-radius: 4px;
  background: transparent; color: var(--fg);
  font: inherit; font-size: .95em; cursor: pointer; line-height: 1;
}
.theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
.bar-actions { display: flex; gap: .4rem; align-items: center; }
.bar-actions a, .bar-actions button {
  padding: .25rem .65rem; border: 1px solid var(--border);
  border-radius: 4px; background: transparent; color: var(--fg);
  text-decoration: none; font: inherit; font-size: .85em; cursor: pointer;
}
.bar-actions a:hover, .bar-actions button:hover {
  border-color: var(--accent); color: var(--accent);
}
main {
  flex: 1; max-width: 48rem; width: 100%; margin: 0 auto;
  padding: 1.5rem 1.25rem;
}
main.full { max-width: none; padding: 0; }
h1, h2, h3 { line-height: 1.25; margin-top: 1.6em; }
main > h1:first-child { margin-top: 0; }
h1 { border-bottom: 1px solid var(--border); padding-bottom: .3em; }
a { color: var(--accent); }
code {
  background: var(--code-bg); padding: .15em .35em;
  border-radius: 3px; font-size: .92em;
}
pre { background: var(--code-bg); padding: 1rem; overflow-x: auto; border-radius: 4px; }
pre code { padding: 0; background: transparent; font-size: .9em; }
blockquote {
  border-left: 3px solid var(--border); padding-left: 1rem;
  color: var(--muted); margin-left: 0;
}
table { border-collapse: collapse; }
td, th { border: 1px solid var(--border); padding: .35em .7em; }
hr { border: none; border-top: 1px solid var(--border); margin: 2em 0; }
table.files { width: 100%; border-collapse: collapse; }
table.files th, table.files td { border: 0; padding: .35rem .5rem; }
table.files thead th {
  text-align: left; font-weight: 500;
  color: var(--muted); font-size: .8em;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  border-bottom: 1px solid var(--border);
  cursor: pointer; user-select: none; background: transparent;
}
table.files thead th:hover { color: var(--accent); }
table.files thead th[data-sort-dir="asc"]::after  { content: " ▲"; opacity: .7; }
table.files thead th[data-sort-dir="desc"]::after { content: " ▼"; opacity: .7; }
table.files tbody tr { border-bottom: 1px solid var(--border); }
table.files td {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}
table.files td.col-name a { text-decoration: none; }
table.files td.col-name a:hover { text-decoration: underline; }
table.files th.col-size, table.files th.col-mtime,
table.files td.col-size, table.files td.col-mtime,
table.files th.col-git-xy, table.files th.col-git-num,
table.files td.col-git-xy, table.files td.col-git-num {
  text-align: right; white-space: nowrap;
}
table.files td.col-size, table.files td.col-mtime {
  color: var(--muted); font-size: .85em;
}
table.files td.col-git-xy {
  color: var(--muted); font-size: .85em;
  white-space: pre; /* preserve leading/embedded spaces in "M " or " M" */
}
table.files td.col-git-num { font-size: .85em; }
table.files .git-add { color: #15803d; }
table.files .git-del { color: #b91c1c; }
:root[data-theme="dark"] table.files .git-add { color: #4ade80; }
:root[data-theme="dark"] table.files .git-del { color: #f87171; }
table.files td.empty { color: var(--muted); padding: 1rem .5rem; text-align: left; }
table.files td.col-name .no-link { color: var(--muted); }

/* Row visibility driven by two body data-attrs the cycle buttons set.
   Class cycle: "md" hides text+other; "text" hides other; "all" shows all.
   Hidden cycle: "normal" hides dotfiles + ignored; "hidden" exposes
   dotfiles but still hides ignored; "ignored" exposes both. */
body[data-index-class="md"]   table.files tr[data-class="text"],
body[data-index-class="md"]   table.files tr[data-class="other"],
body[data-index-class="text"] table.files tr[data-class="other"] { display: none; }
body[data-index-hidden="normal"] table.files tr[data-hidden="1"],
body[data-index-hidden="normal"] table.files tr[data-ignored="1"],
body[data-index-hidden="hidden"] table.files tr[data-ignored="1"] { display: none; }
table.files tr[data-ignored="1"] td { opacity: .55; font-style: italic; }
table.files tr[data-hidden="1"]:not([data-ignored="1"]) td.col-name { color: var(--muted); }
footer {
  border-top: 1px solid var(--border); padding: .75rem 1rem;
  color: var(--muted); font-size: .8em;
  display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}
footer a { color: var(--muted); }
.status { color: var(--muted); font-size: .8em; }
.status.ok { color: #15803d; }
.status.err { color: #b91c1c; }
:root[data-theme="dark"] .status.ok { color: #4ade80; }
:root[data-theme="dark"] .status.err { color: #f87171; }

/* markup view: source visible, content styled */
.md-markup {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 14px; line-height: 1.65;
  white-space: pre-wrap; word-wrap: break-word;
}
.md-markup .md-line { display: block; }
.md-markup .md-blank { height: 1.4em; }
.md-markup .md-marker { color: var(--muted); opacity: 0.5; font-weight: 400; }
.md-markup .md-text { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
  "Helvetica Neue", Arial, sans-serif; }
.md-markup .md-h1 .md-text { font-size: 1.55em; font-weight: 700; line-height: 1.25; }
.md-markup .md-h2 .md-text { font-size: 1.3em;  font-weight: 700; line-height: 1.3; }
.md-markup .md-h3 .md-text { font-size: 1.12em; font-weight: 600; }
.md-markup .md-h4 .md-text,
.md-markup .md-h5 .md-text,
.md-markup .md-h6 .md-text { font-weight: 600; }
.md-markup strong { font-weight: 700; }
.md-markup em { font-style: italic; }
.md-markup code { background: var(--code-bg); padding: 0 .25em; border-radius: 2px; }
.md-markup .md-fence,
.md-markup .md-code { color: var(--fg); }
.md-markup .md-code .md-marker { color: var(--fg); opacity: 1; background: var(--code-bg); padding: 0 .15em; }
.md-markup .md-fence .md-marker { background: var(--code-bg); padding: 0 .15em; }
.md-markup .md-bq { color: var(--muted); }
.md-markup .md-li .md-marker { color: var(--accent); opacity: 0.7; }
.md-markup a { color: var(--accent); text-decoration: underline; }
.md-markup .md-link-url { color: var(--muted); opacity: 0.55; font-size: .92em; }

/* command palette + index filter */
.bar-actions input[type="search"], .bar-actions input[type="text"]#index-filter {
  padding: .25rem .55rem; border: 1px solid var(--border);
  border-radius: 4px; background: transparent; color: var(--fg);
  font: inherit; font-size: .9em; min-width: 14em;
}
.bar-actions input:focus { outline: none; border-color: var(--accent); }
mark { background: rgba(255, 215, 0, 0.45); color: inherit; padding: 0 .05em; border-radius: 2px; }
:root[data-theme="dark"] mark { background: rgba(252, 211, 77, 0.55); color: #1a1a1a; }

/* Persistent left sidebar — opens on ⌘K / Ctrl-K, sticks until Esc or
   another ⌘K. No backdrop, no click-outside-to-close: the goal is to
   leave the file list available while you read, so you can jump
   between files without re-opening anything. */
.palette {
  position: fixed; top: 0; left: 0; bottom: 0;
  width: min(20rem, 92vw);
  background: var(--bar-bg); border-right: 1px solid var(--border);
  z-index: 1000;
  display: flex; flex-direction: column;
  transform: translateX(-100%);
  transition: transform 0.18s ease;
  box-shadow: 4px 0 16px rgba(0, 0, 0, 0.08);
}
.palette[data-open="1"] { transform: translateX(0); }
.palette-box {
  flex: 1; display: flex; flex-direction: column;
  background: transparent; border: 0; border-radius: 0;
  width: 100%; box-shadow: none; overflow: hidden;
}
.palette-box input {
  width: 100%; padding: .85rem 1rem; border: 0;
  border-bottom: 1px solid var(--border);
  background: transparent; color: var(--fg);
  font: inherit; font-size: 1rem; outline: none;
}
.palette-box ul {
  list-style: none; padding: .25rem 0; margin: 0;
  flex: 1; overflow-y: auto;
}
.palette-item {
  padding: .45rem 1rem; cursor: pointer;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: .9rem; line-height: 1.4;
  display: flex; align-items: baseline; gap: .6em;
}
.palette-item:hover { background: var(--code-bg); }
.palette-selected { background: var(--code-bg); }
.palette-selected::before { content: "▸"; color: var(--accent); margin-right: .25em; }
.palette-path { flex: 1; min-width: 0; word-break: break-all; }
.palette-time { color: var(--muted); font-size: .8em; flex-shrink: 0; opacity: .75; }

/* Sub-path coloring used by both the palette and the index inline filter */
.path-dim { color: var(--muted); }

/* When sidebar is pinned open, shift main content right so it doesn't
   get covered. On narrow viewports the sidebar takes the whole screen
   instead. */
body.palette-open { padding-left: min(20rem, 92vw); transition: padding-left 0.18s ease; }
@media (max-width: 700px) {
  body.palette-open { padding-left: 0; }
  .palette { width: 100vw; box-shadow: none; }
}

/* edit-page split-pane */
main.split {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0;
  height: calc(100vh - 92px); max-width: none; padding: 0;
}
main.split textarea {
  border: 0; border-right: 1px solid var(--border);
  padding: 1rem; resize: none; outline: none;
  font: 14px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace;
  background: var(--bg); color: var(--fg);
}
main.split .preview { padding: 1rem 1.5rem; overflow-y: auto; }
main.split .preview > h1:first-child { margin-top: 0; }
@media (max-width: 800px) {
  main.split { grid-template-columns: 1fr; height: auto; }
  main.split textarea { min-height: 40vh; border-right: 0; border-bottom: 1px solid var(--border); }
}
</style>
{{end}}
