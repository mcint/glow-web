<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}{{if .TitlePrefix}} · {{.TitlePrefix}}{{end}}</title>
{{template "theme-init" .}}
{{template "style" .}}
</head>
<body>
<header class="bar">
  {{template "crumbs" .}}
  <nav class="bar-actions">
    {{if .ToggleURL}}<a href="{{.ToggleURL}}">{{.ToggleLabel}}</a>{{end}}
    <a href="{{.RawURL}}">Raw</a>
    <a href="{{.DownloadURL}}">Download</a>
    {{if .EditURL}}<a href="{{.EditURL}}">Edit</a>{{end}}
    <button id="theme-toggle" type="button" class="theme-toggle">◐</button>
  </nav>
</header>
<main>
{{.Body}}
</main>
{{template "footer" .}}
{{template "scripts" .}}
</body>
</html>
