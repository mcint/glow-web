{{define "scripts"}}
<script>
// All localStorage keys are namespaced via KEY_PREFIX (per-project hash) so
// two glow-web instances on the same browser origin can't trample each
// other's UI state. KEY_PREFIX is shared across the theme toggle, the
// sidebar open/close state, and the per-file scroll memory below.
const KEY_PREFIX = {{.KeyPrefix}};
function K(suffix) { return KEY_PREFIX + suffix; }
</script>
<script>
// theme toggle: cycles auto → light → dark → auto, persists in localStorage,
// and re-applies on system preference changes when in 'auto' mode. The
// theme-init partial in <head> handles the initial paint; this just wires
// up the bar button and runtime cycling.
(function() {
  var btn = document.getElementById('theme-toggle');
  if (!btn) return;
  var ICONS  = {auto: '◐', light: '☀', dark: '☾'};
  var ORDER  = ['auto', 'light', 'dark'];
  function getChoice() {
    try { return localStorage.getItem(K('theme')) || 'auto'; }
    catch (e) { return 'auto'; }
  }
  function setChoice(c) {
    try {
      if (c === 'auto') localStorage.removeItem(K('theme'));
      else              localStorage.setItem(K('theme'), c);
    } catch (e) {}
    apply();
    paint();
  }
  function apply() {
    var c = getChoice();
    var systemDark = window.matchMedia &&
                     window.matchMedia('(prefers-color-scheme: dark)').matches;
    var t = (c === 'auto') ? (systemDark ? 'dark' : 'light') : c;
    document.documentElement.setAttribute('data-theme', t);
  }
  function paint() {
    var c = getChoice();
    btn.textContent = ICONS[c] || ICONS.auto;
    btn.title = 'theme: ' + c + ' (click to cycle)';
    btn.setAttribute('aria-label', 'theme: ' + c);
  }
  btn.addEventListener('click', function() {
    var cur = getChoice();
    setChoice(ORDER[(ORDER.indexOf(cur) + 1) % ORDER.length]);
  });
  if (window.matchMedia) {
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
      if (getChoice() === 'auto') apply();
    });
  }
  paint();
})();
</script>
{{if .Palette}}
<aside id="palette" class="palette" role="navigation" aria-label="files">
  <div class="palette-box">
    <input id="palette-input" type="text" placeholder="jump to file…  (esc to close)"
           autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
    <ul id="palette-results" role="listbox"></ul>
  </div>
</aside>
{{end}}
<script>
(function() {
  // ---- shared fuzzy match ----
  // Subsequence match with fzf-style scoring: rewards contiguous runs and
  // word-boundary hits, penalises later positions. Lower score = better.
  //
  // Whitespace in the query splits it into ordered tokens — each token must
  // subsequence-match in order, advancing past the previous token. Lets
  // users type `cc 5w se` to match `cc/5wh/seed.md` (one token per path
  // segment) without typing the slashes. Word-boundary bonus fires on a
  // token's first char when it lands right after a `/` or `_`, so cleanly-
  // segmented matches outscore cluttered ones.
  function fuzzyMatch(query, target) {
    const trimmed = (query || '').trim();
    if (!trimmed) return { match: true, indices: [], score: 0 };
    const tokens = trimmed.toLowerCase().split(/\s+/);
    const t = target.toLowerCase();
    const allIndices = [];
    let cursor = 0;
    let totalScore = 0;
    for (const tok of tokens) {
      let i = 0, lastHit = -2;
      const tokIdx = [];
      let tokScore = 0;
      for (let j = cursor; j < t.length && i < tok.length; j++) {
        if (t[j] === tok[i]) {
          tokIdx.push(j);
          if (j === lastHit + 1) tokScore -= 4;                   // contiguous bonus
          if (j === 0 || /[\W_/]/.test(t[j-1])) tokScore -= 6;    // word-boundary bonus
          tokScore += j * 0.5;                                    // earlier-is-better
          lastHit = j;
          i++;
        }
      }
      if (i < tok.length) return { match: false, indices: [], score: 0 };
      allIndices.push(...tokIdx);
      totalScore += tokScore;
      cursor = lastHit + 1;
    }
    return { match: true, indices: allIndices, score: totalScore };
  }
  function escapeHTML(s) {
    return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
  }
  function highlight(text, indices) {
    if (!indices || !indices.length) return escapeHTML(text);
    let out = '', last = 0;
    for (const idx of indices) {
      out += escapeHTML(text.slice(last, idx)) + '<mark>' + escapeHTML(text[idx]) + '</mark>';
      last = idx + 1;
    }
    return out + escapeHTML(text.slice(last));
  }

  // Split rel "specs/sub/foo.md" into [dir="specs/sub/", file="foo.md"].
  // Highlight indices must be split too — directory keeps indices ≤ slash
  // position, file gets the remaining indices shifted by (slash+1).
  function renderSubPath(rel, indices) {
    const slash = rel.lastIndexOf('/');
    if (slash < 0) return highlight(rel, indices);
    const dirText  = rel.slice(0, slash + 1);
    const fileText = rel.slice(slash + 1);
    const dirIdx   = (indices || []).filter(i => i <= slash);
    const fileIdx  = (indices || []).filter(i => i >  slash).map(i => i - slash - 1);
    return '<span class="path-dim">' + highlight(dirText, dirIdx) + '</span>' + highlight(fileText, fileIdx);
  }

  // Compact relative time: now / 5m / 3h / 2d / 6w / 4mo / 2y. Empty when
  // mtime is 0 or missing.
  function relTime(unixSec) {
    if (!unixSec) return '';
    const ageS = Math.max(0, Date.now()/1000 - unixSec);
    if (ageS < 45)        return 'now';
    if (ageS < 3600)      return Math.round(ageS/60) + 'm';
    if (ageS < 86400)     return Math.round(ageS/3600) + 'h';
    if (ageS < 86400*7)   return Math.round(ageS/86400) + 'd';
    if (ageS < 86400*30)  return Math.round(ageS/(86400*7)) + 'w';
    if (ageS < 86400*365) return Math.round(ageS/(86400*30)) + 'mo';
    return Math.round(ageS/(86400*365)) + 'y';
  }

  // ---- index page: inline filter + column sort (both client-side) ----
  // The table is server-emitted in default order (by Rel). The filter
  // sorts by fuzzy score when active; when the filter is empty, the
  // last user-chosen sort (or default) decides row order. State for
  // the sort persists in localStorage as "<key>:<dir>".
  const indexFilter = document.getElementById('index-filter');
  const indexTbody = document.querySelector('table.files tbody');
  const sortHeaders = document.querySelectorAll('table.files thead th[data-sort-key]');
  if (indexFilter && indexTbody) {
    const items = Array.from(indexTbody.querySelectorAll('tr[data-rel]'));
    const counter = document.getElementById('count');
    const SORT_KEY = K('index-sort');
    let sortState = { key: '', dir: '' };
    try {
      const raw = localStorage.getItem(SORT_KEY) || '';
      const i = raw.indexOf(':');
      if (i > 0) sortState = { key: raw.slice(0, i), dir: raw.slice(i + 1) };
    } catch (e) {}

    function rowCmp(key, dir) {
      const m = dir === 'desc' ? -1 : 1;
      return (a, b) => {
        if (key === 'size')  return m * (parseInt(a.dataset.size  || '0', 10) - parseInt(b.dataset.size  || '0', 10));
        if (key === 'mtime') return m * (parseInt(a.dataset.mtime || '0', 10) - parseInt(b.dataset.mtime || '0', 10));
        return m * a.dataset.rel.localeCompare(b.dataset.rel);
      };
    }
    function paintSortHeaders() {
      sortHeaders.forEach(h => {
        if (h.dataset.sortKey === sortState.key && sortState.dir) {
          h.setAttribute('data-sort-dir', sortState.dir);
        } else {
          h.removeAttribute('data-sort-dir');
        }
      });
    }
    function persistSort() {
      try {
        if (sortState.key && sortState.dir) localStorage.setItem(SORT_KEY, sortState.key + ':' + sortState.dir);
        else                                localStorage.removeItem(SORT_KEY);
      } catch (e) {}
    }

    // Visible iff class+hidden body attrs admit this row. CSS does the
    // actual hiding via display:none; we duplicate the logic in JS only
    // to keep the count honest.
    function passesToggle(tr) {
      const cls = document.body.getAttribute('data-index-class')   || 'md';
      const hid = document.body.getAttribute('data-index-hidden') || 'normal';
      const c = tr.dataset.class || 'md';
      if (cls === 'md'   && c !== 'md') return false;
      if (cls === 'text' && c === 'other') return false;
      if (hid === 'normal' && (tr.dataset.hidden || tr.dataset.ignored)) return false;
      if (hid === 'hidden' && tr.dataset.ignored) return false;
      return true;
    }

    const rerender = () => {
      const q = indexFilter.value;
      let visible = 0;
      let ordered;
      if (q.trim()) {
        // Filter active: rank by fuzzy score, descending match-first.
        const scored = items.map(tr => ({ tr, ...fuzzyMatch(q, tr.dataset.rel) }));
        scored.sort((a, b) => (a.match === b.match) ? a.score - b.score : (a.match ? -1 : 1));
        ordered = scored;
      } else {
        // No filter: respect sort state (or default by Rel).
        const cmp = rowCmp(sortState.key || 'name', sortState.dir || 'asc');
        ordered = items.slice().sort((a, b) => cmp(a, b)).map(tr => ({ tr, match: true, indices: [] }));
      }
      indexTbody.innerHTML = '';
      for (const s of ordered) {
        if (!s.match) { s.tr.style.display = 'none'; continue; }
        s.tr.style.display = '';
        const link = s.tr.querySelector('td.col-name a');
        if (link) link.innerHTML = renderSubPath(s.tr.dataset.rel, s.indices);
        indexTbody.appendChild(s.tr);
        if (passesToggle(s.tr)) visible++;
      }
      if (counter) counter.textContent = visible + ' files';
    };
    // Expose so the cycle toggles can refresh the count without
    // duplicating the count walk.
    window.__indexRerender = rerender;

    sortHeaders.forEach(h => {
      h.addEventListener('click', () => {
        const k = h.dataset.sortKey;
        if (sortState.key !== k)        sortState = { key: k, dir: 'asc'  };
        else if (sortState.dir === 'asc')  sortState = { key: k, dir: 'desc' };
        else                                sortState = { key: '', dir: ''   };
        paintSortHeaders();
        persistSort();
        rerender();
      });
    });

    indexFilter.addEventListener('input', rerender);
    indexFilter.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        const first = indexTbody.querySelector('tr[data-rel] td.col-name a');
        if (first) { e.preventDefault(); location.href = first.href; }
      } else if (e.key === 'Escape') {
        indexFilter.value = '';
        rerender();
      }
    });

    paintSortHeaders();
    // Apply restored sort on initial paint (server emitted default order).
    if (sortState.key && sortState.dir) rerender();
  }

  // ---- class + hidden cycle toggles (index page) ----
  // Each toggle is a 3-state cycle persisted in localStorage. CSS keys off
  // body[data-index-class] / body[data-index-hidden] to hide rows; the JS
  // just paints the button label and writes the body attr.
  function wireCycle(btnId, attrName, storageKey, order, labels) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    const KEY = K(storageKey);
    function get() {
      try { return localStorage.getItem(KEY) || order[0]; }
      catch (e) { return order[0]; }
    }
    function set(v) {
      try {
        if (v === order[0]) localStorage.removeItem(KEY);
        else                localStorage.setItem(KEY, v);
      } catch (e) {}
      apply();
    }
    function apply() {
      const v = get();
      document.body.setAttribute(attrName, v);
      btn.textContent = labels[v] || labels[order[0]];
      if (typeof window.__indexRerender === 'function') window.__indexRerender();
    }
    btn.addEventListener('click', () => {
      const cur = get();
      set(order[(order.indexOf(cur) + 1) % order.length]);
    });
    apply();
  }
  wireCycle('class-toggle',  'data-index-class',  'index-class',
            ['md', 'text', 'all'],
            {md: '[md]', text: '[+text]', all: '[all]'});
  wireCycle('hidden-toggle', 'data-index-hidden', 'index-hidden',
            ['normal', 'hidden', 'ignored'],
            {normal: '[normal]', hidden: '[+hidden]', ignored: '[+ignored]'});

  // ---- file palette as persistent left sidebar ----
  // Opens on ⌘K / Ctrl-K, sticks across page navigations via localStorage,
  // closes on Esc or another ⌘K. The sidebar overlays a slide-in panel
  // and shifts main content right (CSS handles the layout) so the
  // reading column stays visible. Restoring on each page load preserves
  // the "open while jumping between files" workflow.
  const palette = document.getElementById('palette');
  if (!palette) return;
  const input = document.getElementById('palette-input');
  const results = document.getElementById('palette-results');
  const filesURL = {{.FilesURL}};
  let files = null;
  let current = [];
  let selected = 0;
  const STATE_KEY = K('palette-open');

  function loadFiles(then) {
    fetch(filesURL).then(r => r.ok ? r.json() : []).then(data => {
      files = data;
      if (then) then();
    }).catch(() => { files = []; if (then) then(); });
  }
  function open(focusInput) {
    palette.dataset.open = '1';
    document.body.classList.add('palette-open');
    try { localStorage.setItem(STATE_KEY, '1'); } catch (e) {}
    input.value = '';
    selected = 0;
    if (files === null) loadFiles(render);
    else render();
    if (focusInput) setTimeout(() => input.focus(), 0);
  }
  function close() {
    palette.dataset.open = '';
    document.body.classList.remove('palette-open');
    try { localStorage.setItem(STATE_KEY, '0'); } catch (e) {}
    input.blur();
  }
  function isOpen() { return palette.dataset.open === '1'; }
  function move(dir) {
    if (!current.length) return;
    selected = (selected + dir + current.length) % current.length;
    paint();
  }
  function go() {
    const item = current[selected];
    if (item) location.href = item.url;
  }
  function render() {
    if (!files) { results.innerHTML = ''; return; }
    const q = input.value;
    const scored = files.map(f => ({ ...f, ...fuzzyMatch(q, f.rel) }))
                       .filter(s => s.match)
                       .sort((a, b) => a.score - b.score);
    current = scored.slice(0, 200);
    if (selected >= current.length) selected = 0;
    paint();
  }
  function paint() {
    results.innerHTML = current.map((s, i) => {
      const cls = i === selected ? 'palette-item palette-selected' : 'palette-item';
      const path = renderSubPath(s.rel, s.indices);
      const t = relTime(s.mtime);
      const time = t ? `<span class="palette-time">${t}</span>` : '';
      return `<li class="${cls}" data-i="${i}"><span class="palette-path">${path}</span>${time}</li>`;
    }).join('');
    Array.from(results.children).forEach(li => {
      li.addEventListener('click', () => {
        selected = parseInt(li.dataset.i, 10);
        go();
      });
    });
    const sel = results.querySelector('.palette-selected');
    if (sel) sel.scrollIntoView({ block: 'nearest' });
  }

  window.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      isOpen() ? close() : open(true);
    } else if (e.key === 'Escape' && isOpen() && document.activeElement === input) {
      e.preventDefault();
      close();
    }
  });
  input.addEventListener('input', render);
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter')  { e.preventDefault(); go(); }
    else if (e.key === 'Escape') { e.preventDefault(); close(); }
  });

  // Restore prior open state without auto-focusing the input — the user
  // is presumably reading the page, not typing.
  let stored = null;
  try { stored = localStorage.getItem(STATE_KEY); } catch (e) {}
  if (stored === '1') open(false);
})();
</script>

<script>
// Per-file scroll-position memory. Saves window scrollY as a fraction of
// scrollable height keyed by location.pathname (so each doc remembers
// where you left off). On load, jumps back unless the URL has a #anchor
// (anchor scroll wins). localStorage only — no cookies.
(function() {
  const key = K('scroll:' + location.pathname);
  const SAVE_DEBOUNCE_MS = 250;
  let saveTimer;
  function maxScroll() {
    return Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
  }
  function save() {
    const pct = window.scrollY / maxScroll();
    try {
      if (pct < 0.005) localStorage.removeItem(key);
      else             localStorage.setItem(key, pct.toFixed(4));
    } catch (e) {}
  }
  window.addEventListener('scroll', () => {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(save, SAVE_DEBOUNCE_MS);
  }, { passive: true });

  if (location.hash) return; // anchor scroll wins
  let saved = null;
  try { saved = localStorage.getItem(key); } catch (e) {}
  if (!saved) return;
  const pct = parseFloat(saved);
  if (isNaN(pct) || pct <= 0.01) return;
  // Defer until layout settles (images, fonts).
  function restore() { window.scrollTo(0, pct * maxScroll()); }
  if (document.readyState === 'complete') requestAnimationFrame(restore);
  else window.addEventListener('load', () => requestAnimationFrame(restore), { once: true });
})();
</script>
{{end}}
