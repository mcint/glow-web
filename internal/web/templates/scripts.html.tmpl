{{define "scripts"}}
<script>
// theme toggle: cycles auto → light → dark → auto, persists in localStorage,
// and re-applies on system preference changes when in 'auto' mode. The
// theme-init partial in <head> handles the initial paint; this just wires
// up the bar button and runtime cycling.
(function() {
  var btn = document.getElementById('theme-toggle');
  if (!btn) return;
  var ICONS  = {auto: '◐', light: '☀', dark: '☾'};
  var ORDER  = ['auto', 'light', 'dark'];
  function getChoice() {
    try { return localStorage.getItem('glow-theme') || 'auto'; }
    catch (e) { return 'auto'; }
  }
  function setChoice(c) {
    try {
      if (c === 'auto') localStorage.removeItem('glow-theme');
      else              localStorage.setItem('glow-theme', c);
    } catch (e) {}
    apply();
    paint();
  }
  function apply() {
    var c = getChoice();
    var systemDark = window.matchMedia &&
                     window.matchMedia('(prefers-color-scheme: dark)').matches;
    var t = (c === 'auto') ? (systemDark ? 'dark' : 'light') : c;
    document.documentElement.setAttribute('data-theme', t);
  }
  function paint() {
    var c = getChoice();
    btn.textContent = ICONS[c] || ICONS.auto;
    btn.title = 'theme: ' + c + ' (click to cycle)';
    btn.setAttribute('aria-label', 'theme: ' + c);
  }
  btn.addEventListener('click', function() {
    var cur = getChoice();
    setChoice(ORDER[(ORDER.indexOf(cur) + 1) % ORDER.length]);
  });
  if (window.matchMedia) {
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
      if (getChoice() === 'auto') apply();
    });
  }
  paint();
})();
</script>
{{if .Palette}}
<aside id="palette" class="palette" role="navigation" aria-label="files">
  <div class="palette-box">
    <input id="palette-input" type="text" placeholder="jump to file…  (esc to close)"
           autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
    <ul id="palette-results" role="listbox"></ul>
  </div>
</aside>
{{end}}
<script>
(function() {
  // ---- shared fuzzy match ----
  // Subsequence match with fzf-style scoring: rewards contiguous runs and
  // word-boundary hits, penalises later positions. Lower score = better.
  function fuzzyMatch(query, target) {
    if (!query) return { match: true, indices: [], score: 0 };
    const q = query.toLowerCase(), t = target.toLowerCase();
    const indices = [];
    let i = 0, score = 0, last = -2;
    for (let j = 0; j < t.length && i < q.length; j++) {
      if (t[j] === q[i]) {
        indices.push(j);
        if (j === last + 1) score -= 4;                          // contiguous bonus
        if (j === 0 || /[\W_/]/.test(t[j-1])) score -= 6;        // word-boundary bonus
        score += j * 0.5;                                        // earlier-is-better
        last = j;
        i++;
      }
    }
    return { match: i === q.length, indices, score };
  }
  function escapeHTML(s) {
    return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
  }
  function highlight(text, indices) {
    if (!indices || !indices.length) return escapeHTML(text);
    let out = '', last = 0;
    for (const idx of indices) {
      out += escapeHTML(text.slice(last, idx)) + '<mark>' + escapeHTML(text[idx]) + '</mark>';
      last = idx + 1;
    }
    return out + escapeHTML(text.slice(last));
  }

  // ---- index page inline filter (data already in DOM) ----
  const indexFilter = document.getElementById('index-filter');
  const indexList = document.querySelector('ul.files');
  if (indexFilter && indexList) {
    const items = Array.from(indexList.querySelectorAll('li[data-rel]'));
    const counter = document.getElementById('count');
    const rerender = () => {
      const q = indexFilter.value;
      let visible = 0;
      const scored = items.map(li => ({ li, ...fuzzyMatch(q, li.dataset.rel) }));
      scored.sort((a, b) => (a.match === b.match) ? a.score - b.score : (a.match ? -1 : 1));
      indexList.innerHTML = '';
      for (const s of scored) {
        if (!s.match) { s.li.style.display = 'none'; continue; }
        s.li.style.display = '';
        const link = s.li.querySelector('a');
        if (link) link.innerHTML = highlight(s.li.dataset.rel, s.indices);
        indexList.appendChild(s.li);
        visible++;
      }
      if (counter) counter.textContent = visible + ' files';
    };
    indexFilter.addEventListener('input', rerender);
    indexFilter.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        const first = indexList.querySelector('li[data-rel] a');
        if (first) { e.preventDefault(); location.href = first.href; }
      } else if (e.key === 'Escape') {
        indexFilter.value = '';
        rerender();
      }
    });
  }

  // ---- file palette as persistent left sidebar ----
  // Opens on ⌘K / Ctrl-K, sticks across page navigations via localStorage,
  // closes on Esc or another ⌘K. The sidebar overlays a slide-in panel
  // and shifts main content right (CSS handles the layout) so the
  // reading column stays visible. Restoring on each page load preserves
  // the "open while jumping between files" workflow.
  const palette = document.getElementById('palette');
  if (!palette) return;
  const input = document.getElementById('palette-input');
  const results = document.getElementById('palette-results');
  const filesURL = {{.FilesURL}};
  let files = null;
  let current = [];
  let selected = 0;
  const STATE_KEY = 'glow-palette-open';

  function loadFiles(then) {
    fetch(filesURL).then(r => r.ok ? r.json() : []).then(data => {
      files = data;
      if (then) then();
    }).catch(() => { files = []; if (then) then(); });
  }
  function open(focusInput) {
    palette.dataset.open = '1';
    document.body.classList.add('palette-open');
    try { localStorage.setItem(STATE_KEY, '1'); } catch (e) {}
    input.value = '';
    selected = 0;
    if (files === null) loadFiles(render);
    else render();
    if (focusInput) setTimeout(() => input.focus(), 0);
  }
  function close() {
    palette.dataset.open = '';
    document.body.classList.remove('palette-open');
    try { localStorage.setItem(STATE_KEY, '0'); } catch (e) {}
    input.blur();
  }
  function isOpen() { return palette.dataset.open === '1'; }
  function move(dir) {
    if (!current.length) return;
    selected = (selected + dir + current.length) % current.length;
    paint();
  }
  function go() {
    const item = current[selected];
    if (item) location.href = item.url;
  }
  function render() {
    if (!files) { results.innerHTML = ''; return; }
    const q = input.value;
    const scored = files.map(f => ({ ...f, ...fuzzyMatch(q, f.rel) }))
                       .filter(s => s.match)
                       .sort((a, b) => a.score - b.score);
    current = scored.slice(0, 200);
    if (selected >= current.length) selected = 0;
    paint();
  }
  function paint() {
    results.innerHTML = current.map((s, i) => {
      const cls = i === selected ? 'palette-item palette-selected' : 'palette-item';
      return `<li class="${cls}" data-i="${i}">${highlight(s.rel, s.indices)}</li>`;
    }).join('');
    Array.from(results.children).forEach(li => {
      li.addEventListener('click', () => {
        selected = parseInt(li.dataset.i, 10);
        go();
      });
    });
    const sel = results.querySelector('.palette-selected');
    if (sel) sel.scrollIntoView({ block: 'nearest' });
  }

  window.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      isOpen() ? close() : open(true);
    } else if (e.key === 'Escape' && isOpen() && document.activeElement === input) {
      e.preventDefault();
      close();
    }
  });
  input.addEventListener('input', render);
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter')  { e.preventDefault(); go(); }
    else if (e.key === 'Escape') { e.preventDefault(); close(); }
  });

  // Restore prior open state without auto-focusing the input — the user
  // is presumably reading the page, not typing.
  let stored = null;
  try { stored = localStorage.getItem(STATE_KEY); } catch (e) {}
  if (stored === '1') open(false);
})();
</script>

<script>
// Per-file scroll-position memory. Saves window scrollY as a fraction of
// scrollable height keyed by location.pathname (so each doc remembers
// where you left off). On load, jumps back unless the URL has a #anchor
// (anchor scroll wins). localStorage only — no cookies.
(function() {
  const key = 'glow-scroll:' + location.pathname;
  const SAVE_DEBOUNCE_MS = 250;
  let saveTimer;
  function maxScroll() {
    return Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
  }
  function save() {
    const pct = window.scrollY / maxScroll();
    try {
      if (pct < 0.005) localStorage.removeItem(key);
      else             localStorage.setItem(key, pct.toFixed(4));
    } catch (e) {}
  }
  window.addEventListener('scroll', () => {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(save, SAVE_DEBOUNCE_MS);
  }, { passive: true });

  if (location.hash) return; // anchor scroll wins
  let saved = null;
  try { saved = localStorage.getItem(key); } catch (e) {}
  if (!saved) return;
  const pct = parseFloat(saved);
  if (isNaN(pct) || pct <= 0.01) return;
  // Defer until layout settles (images, fonts).
  function restore() { window.scrollTo(0, pct * maxScroll()); }
  if (document.readyState === 'complete') requestAnimationFrame(restore);
  else window.addEventListener('load', () => requestAnimationFrame(restore), { once: true });
})();
</script>
{{end}}
