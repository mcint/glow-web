<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}{{if .TitlePrefix}} · {{.TitlePrefix}}{{end}}</title>
{{template "theme-init" .}}
{{template "style" .}}
</head>
<body>
<header class="bar">
  {{template "crumbs" .}}
  <nav class="bar-actions">
    <input type="text" id="index-filter" placeholder="filter…" autocomplete="off"
           autocapitalize="off" spellcheck="false">
    <span class="bar-path" id="count">{{.Count}} files</span>
    <button id="theme-toggle" type="button" class="theme-toggle">◐</button>
  </nav>
</header>
<main>
<table class="files">
  <thead>
    <tr>
      <th class="col-name"  data-sort-key="name">name</th>
      <th class="col-size"  data-sort-key="size">size</th>
      <th class="col-mtime" data-sort-key="mtime">mtime</th>
    </tr>
  </thead>
  <tbody>
    {{range .Files}}
    <tr data-rel="{{.Rel}}" data-mtime="{{.Mtime}}" data-size="{{.Size}}">
      <td class="col-name"><a href="{{.URL}}">{{.Display}}</a></td>
      <td class="col-size">{{.Size}}</td>
      <td class="col-mtime">{{.MtimeRel}}</td>
    </tr>
    {{else}}
    <tr><td colspan="3" class="empty">(no markdown files found)</td></tr>
    {{end}}
  </tbody>
</table>
</main>
{{template "footer" .}}
{{template "scripts" .}}
</body>
</html>
