<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
{{template "style" .}}
</head>
<body>
<header class="bar">
  {{template "crumbs" .}}
  <nav class="bar-actions">
    <input type="text" id="index-filter" placeholder="filter…" autocomplete="off"
           autocapitalize="off" spellcheck="false">
    <span class="bar-path" id="count">{{.Count}} files</span>
  </nav>
</header>
<main>
<ul class="files">
  {{range .Files}}
  <li data-rel="{{.Rel}}">
    <a href="{{.URL}}">{{.Display}}</a>
    <span class="size">{{.Size}} B</span>
  </li>
  {{else}}
  <li>(no markdown files found)</li>
  {{end}}
</ul>
</main>
{{template "footer" .}}
{{template "scripts" .}}
</body>
</html>
