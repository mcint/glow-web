<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}{{if .TitlePrefix}} · {{.TitlePrefix}}{{end}}</title>
{{template "theme-init" .}}
{{template "style" .}}
</head>
<body data-index-class="md" data-index-hidden="normal">
<header class="bar">
  {{if .Palette}}<button id="sidebar-toggle" type="button" class="sidebar-toggle" title="file list (⌘K)">☰</button>{{end}}
  <div class="browser">
    {{template "crumbs" .}}
    <div class="browser-controls">
      <input type="text" id="index-filter" placeholder="filter…" autocomplete="off"
             autocapitalize="off" spellcheck="false">
      <span class="bar-path" id="count">{{.Count}} files</span>
      <button id="class-toggle" type="button" class="seg-toggle" title="class filter (click to widen)">
        <span class="seg" data-state="md"><span class="seg-label">md</span><b class="seg-n"></b></span>
        <span class="seg" data-state="text"><span class="seg-label">+text</span><b class="seg-n"></b></span>
        <span class="seg" data-state="all"><span class="seg-label">+all</span><b class="seg-n"></b></span>
      </button>
      <button id="hidden-toggle" type="button" class="seg-toggle" title="hidden filter (click to widen)">
        <span class="seg" data-state="normal"><span class="seg-label">normal</span><b class="seg-n"></b></span>
        <span class="seg" data-state="hidden"><span class="seg-label">+hidden</span><b class="seg-n"></b></span>
        <span class="seg" data-state="ignored"><span class="seg-label">+ignored</span><b class="seg-n"></b></span>
      </button>
    </div>
  </div>
  <nav class="bar-actions">
    <button id="theme-toggle" type="button" class="theme-toggle">◐</button>
  </nav>
</header>
<main>
<table class="files">
  <thead>
    <tr>
      <th class="col-name"    data-sort-key="name">name</th>
      <th class="col-size"    data-sort-key="size">size</th>
      <th class="col-mtime"   data-sort-key="mtime">mtime</th>
      <th class="col-git-xy"  data-sort-key="xy" title="git status (porcelain XY)">git</th>
      <th class="col-git-num" data-sort-key="diff" title="git diff vs HEAD (additions / deletions)">±</th>
    </tr>
  </thead>
  <tbody>
    {{range .Files}}
    <tr data-rel="{{.Rel}}" data-mtime="{{.Mtime}}" data-size="{{.Size}}"
        data-class="{{.Class}}"{{if .Hidden}} data-hidden="1"{{end}}{{if .Ignored}} data-ignored="1"{{end}}
        data-xy="{{.GitXY}}" data-adds="{{.GitAdds}}" data-dels="{{.GitDels}}">
      <td class="col-name">{{if .URL}}<a href="{{.URL}}">{{.Display}}</a>{{else}}<span class="no-link">{{.Display}}</span>{{end}}</td>
      <td class="col-size">{{.Size}}</td>
      <td class="col-mtime">{{.MtimeRel}}</td>
      <td class="col-git-xy"{{if eq .GitXY "??"}} data-untracked="1"{{end}}>{{.GitXY}}</td>
      <td class="col-git-num">{{if .GitAdds}}<span class="git-add">+{{.GitAdds}}</span>{{end}}{{if .GitDels}} <span class="git-del">-{{.GitDels}}</span>{{end}}</td>
    </tr>
    {{else}}
    <tr><td colspan="5" class="empty">(no files found)</td></tr>
    {{end}}
  </tbody>
</table>
</main>
{{template "footer" .}}
{{template "scripts" .}}
</body>
</html>
